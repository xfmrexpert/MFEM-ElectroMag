#pragma once

#include <string>

namespace build_info {

constexpr const char* kVersion = "@PROJECT_VERSION@";
constexpr const char* kCommit = "@GIT_COMMIT@@GIT_DIRTY@";

// __DATE__/__TIME__ record when the including translation unit was compiled.
// Every other source file in this project is a header pulled into main.cpp,
// so this is an accurate stamp for the executable as a whole.
constexpr const char* kBuildDate = __DATE__ " " __TIME__;

inline std::string Describe() {
	return std::string("mfem-electromag ") + kVersion +
		" (commit " + kCommit + ", built " + kBuildDate + ")";
}

} // namespace build_info
